<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<title>
			{% block title %}SymBook - A Magical Reading Journey
			{% endblock %}
		</title>

		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
		<!-- Google Fonts for a magical, bookish vibe -->
		
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
		

</head>
<body>
	<!-- Floating Books -->
	<img src="https://img.icons8.com/ios-filled/50/ffffff/book.png" class="floating-book" style="top: 10%; left: 5%; animation-delay: 0s;" alt="Floating Book">
	<img src="https://img.icons8.com/ios-filled/50/ffffff/book.png" class="floating-book" style="top: 20%; right: 10%; animation-delay: 2s;" alt="Floating Book">
	<img src="https://img.icons8.com/ios-filled/50/ffffff/book.png" class="floating-book" style="top: 50%; left: 15%; animation-delay: 4s;" alt="Floating Book">
	<img
	src="https://img.icons8.com/ios-filled/50/ffffff/book.png" class="floating-book" style="top: 70%; right: 20%; animation-delay: 6s;" alt="Floating Book">

	<!-- Navigation Bar -->
	<nav class="navbar navbar-expand-lg">
		<div class="container">
			<a class="navbar-brand" href="{{ path('app_home') }}">SymBook</a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav ms-auto">
					<li class="nav-item">
						<a class="nav-link btn btn-outline-primary me-2" href="{{ path('app_login') }}">Login</a>
					</li>
					<li class="nav-item">
						<a class="nav-link btn btn-outline-primary me-2" href="{{ path('app_register') }}">Signup</a>
					</li>
				</ul>
			</div>
		</div>
	</nav>

	<!-- Main Content -->
	{% block body %}{% endblock %}

	<!-- Bootstrap 5 JS and Popper -->
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
	{% block javascripts %}{% endblock %}
</body></html>