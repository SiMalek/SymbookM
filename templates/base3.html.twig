<!DOCTYPE html>
<html>
	<head>
		<meta charset="UTF-8">
		<title>
			{% block title %}SymBook - A Magical Reading Journey
			{% endblock %}
		</title>
		<link
		href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
		<!-- Google Fonts for a magical, bookish vibe -->
		<link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
	</head>
	<body>
		<!-- Floating Books -->
		<img src="https://img.icons8.com/ios-filled/50/ffffff/book.png" class="floating-book" style="top: 10%; left: 5%; animation-delay: 0s;" alt="Floating Book">
		<img src="https://img.icons8.com/ios-filled/50/ffffff/book.png" class="floating-book" style="top: 20%; right: 10%; animation-delay: 2s;" alt="Floating Book">
		<img src="https://img.icons8.com/ios-filled/50/ffffff/book.png" class="floating-book" style="top: 50%; left: 15%; animation-delay: 4s;" alt="Floating Book">
		<img src="https://img.icons8.com/ios-filled/50/ffffff/book.png" class="floating-book" style="top: 70%; right: 20%; animation-delay: 6s;" alt="Floating Book">

		<nav class="navbar navbar-expand-lg">
			<div class="container">
				<a class="navbar-brand" href="{{ path('app_home') }}">SymBook</a>
				<div class="collapse navbar-collapse">
					<ul class="navbar-nav ms-auto">
						{% if app.user %}
							<li class="nav-item">
								<span class="nav-link">Welcome,
									{{ app.user.email }}</span>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_client') }}">Dashboard</a>
							</li>
							<li class="nav-item">
								<a href="{{ path('app_client_panier') }}" class="btn btn-secondary">
									Voir Panier
								</a>
							</li>
							<li class="nav-item">
								<a href="{{ path('app_client_commandes') }}" class="btn btn-primary">Voir commandes</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
							</li>
						{% else %}
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_login') }}">Login</a>
							</li>
							<li class="nav-item">
								<a class="nav-link" href="{{ path('app_register') }}">Signup</a>
							</li>
						{% endif %}
					</ul>
				</div>
			</div>
		</nav>
		{% block body %}{% endblock %}
		<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
		{% block javascripts %}{% endblock %}
	</body>
</html>
